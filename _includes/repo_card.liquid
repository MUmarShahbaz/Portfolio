{% assign owner = include.repo | split: '/' | first %}
{% assign repo = include.repo | split: '/' | last %}

<div class="repo-card shadow dual-color-container" data-aos="{{ include.AOS }}"><a href="https://github.com/{{ include.repo }}" target="_blank">
  <img class="w-100 h-auto dual-color-light" src="https://github-stats-extended.vercel.app/api/pin/?username={{ owner }}&repo={{ repo }}" alt="{{ repo }} GitHub Repo Card" />
  <img class="w-100 h-auto dual-color-dark" src="https://github-stats-extended.vercel.app/api/pin/?username={{ owner }}&repo={{ repo }}&theme=dark" alt="{{ repo }} GitHub Repo Card" />
</a></div>