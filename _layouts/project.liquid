---
layout: default
---

<header class="bg-dark-black border shadow-lg rounded-5 row p-5 mb-5 overflow-hidden">
    <div class="col-md-4" data-aos="fade-right">
        {% picture medium {{ page.image |  remove: '/img/original/'  }} --parent class="w-100 h-auto rounded" --alt {{ include.alt }} %}
    </div>
    <div class="col-md-8 text-center d-flex justify-content-center flex-column" data-aos="fade-left">
        <h1 class="display-1">{{ page.title }}</h1>
        <p class="lead">{{ page.description }}</p>
        {% share_bar intro %}
    </div>
</header>

{% if page.icons or page.repository or page.external_refrence %}
<section class="my-5">
    <h2 class="display-2 text-center" data-aos="fade-up">Tech Stack</h2>
    {% if page.icons %}
        <div class="row d-flex justify-content-center my-4">
            {% for icon in page.icons %}
                <div class="col-6 col-sm-4 col-md-3 col-lg-2 my-2">
                    {% assign this_icon = site.data.icons |  where_exp: 'i', 'i.name == icon' | first  %}
                    {% include icon_full.liquid icon=this_icon name=icon AOS="fade-up" %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
    {% if page.repository %}
        <div class="d-flex justify-content-center">
            {% include repo_card.liquid repo=page.repository AOS="fade-up" %}
        </div>
    {% endif %}
    {% if page.external_refrence %}
        <div class="d-flex justify-content-center w-100 my-4">
            <a class="btn btn-primary text-white w-75" href="{{ page.external_refrence.url }}" target="_blank">
                {{ page.external_refrence.text }}
            </a>
        </div>
    {% endif %}
</section>
{% endif %}
<hr class="my-5">
<section aria-label="Content" style="font-size: 1.1em">
    {{ content }}
</section>
<hr class="my-5">
<section aria-label="Share this page">
    <p class="display-5 mb-5">Share this page</p>
    {% share_bar end %}
</section>