{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "previewPath": null,
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Article preview",
          "name": "preview",
          "type": "image"
        },
        {
          "title": "Is in draft",
          "name": "draft",
          "type": "draft"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories"
        }
      ]
    },
    {
      "name": "project",
      "pageBundle": false,
      "fields": [
        {
          "title": "Basic Information",
          "name": "heading",
          "type": "heading"
        },
        {
          "title": "Logo",
          "name": "image",
          "type": "image",
          "required": true,
          "isPreviewImage": true
        },
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "type": "divider",
          "name": "divider"
        },
        {
          "title": "Project Details",
          "name": "heading",
          "type": "heading"
        },
        {
          "title": "Repository",
          "name": "repository",
          "type": "string",
          "default": "MUmarShahbaz/REPO"
        },
        {
          "title": "Toolset",
          "name": "icons",
          "type": "list"
        },
        {
          "title": "External URL",
          "name": "external_refrence",
          "type": "fields",
          "fields": [
            {
              "title": "URL",
              "name": "url",
              "type": "string"
            },
            {
              "title": "Text",
              "name": "text",
              "type": "string"
            }
          ]
        },
        {
          "type": "divider",
          "name": "divider"
        },
        {
          "title": "Jekyll Config",
          "name": "heading",
          "type": "heading"
        },
        {
          "title": "Permalink",
          "name": "permalink",
          "type": "string",
          "required": true,
          "default": "/projects/PROJECT.html"
        },
        {
          "title": "Is Featured?",
          "name": "featured",
          "type": "boolean"
        },
        {
          "title": "Project Category",
          "name": "category",
          "type": "choice",
          "choices": [
            "prominent",
            "wip",
            "planned"
          ],
          "required": true
        },
        {
          "title": "Order Prefrence",
          "name": "prefrence",
          "type": "number",
          "required": true
        },
        {
          "title": "Layout",
          "name": "layout",
          "type": "string",
          "editable": false,
          "default": "project",
          "hidden": true
        },
        {
          "type": "divider",
          "name": "divider"
        },
        {
          "title": "Other",
          "name": "heading",
          "type": "heading"
        },
        {
          "title": "container_classes",
          "name": "container_classes",
          "type": "string",
          "default": "container py-5"
        },
        {
          "title": "dynamic_assets",
          "name": "dynamic_assets",
          "type": "fields",
          "fields": [
            {
              "title": "files",
              "name": "files",
              "type": "list"
            }
          ]
        }
      ]
    }
  ],
  "frontMatter.framework.id": "jekyll",
  "frontMatter.content.publicFolder": "assets",
  "frontMatter.preview.host": "http://localhost:4000",
  "frontMatter.content.pageFolders": [
    {
      "title": "Posts",
      "path": "[[workspace]]/_posts"
    },
    {
      "title": "Projects",
      "path": "[[workspace]]/_projects"
    }
  ]
}